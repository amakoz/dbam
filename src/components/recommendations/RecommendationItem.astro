---
import { BadgeCheck, FileCheck, FileText, Wallet } from "lucide-react";
import EntryDetails from "@/components/recommendations/EntryDetails.astro";
import SavedNote from "@/components/recommendations/SavedNote.astro";
import { SAVED_ROW_CLASS, type SavedFeedback } from "@/components/recommendations/saved";
import ScreeningActions from "@/components/recommendations/ScreeningActions.astro";
import TierBadge from "@/components/recommendations/TierBadge.astro";
import { Badge } from "@/components/ui/badge";
import { createT } from "@/i18n";
import type { Recommendation } from "@/lib/catalog/recommend";
import { describeBranch, describeInterval } from "@/lib/catalog/wording";
import { describeLastDone, type ScreeningFormBounds } from "@/lib/screenings/format";
import { anchorMonth, type ScreeningCompletion } from "@/lib/screenings/rules";

interface Props {
  recommendation: Recommendation;
  /** The user's age by year of birth, as `recommend` computed it. */
  age: number;
  bounds: ScreeningFormBounds;
  /** The done record of an exam that is due again, for its "last done" line. */
  lastDone?: ScreeningCompletion;
  /** Translated error of the last plan/done attempt on this exam; opens its panel. */
  error?: string | null;
  /** The form field the error is about, marked invalid in the panel. */
  invalidField?: "date" | "done" | null;
  /** Translated confirmation when this exam was just saved (e.g. its plan removed); highlights the row. */
  saved?: SavedFeedback | null;
}

const { recommendation, age, bounds, lastDone, error, invalidField, saved } = Astro.props;
const { entry, tier, matchedBranch, interval } = recommendation;
const { locale } = Astro.locals;
const t = createT(locale);

const name = locale === "pl" ? entry.name_pl : entry.name_en;
---

<li
  id={`screening-${entry.slug}`}
  data-slug={entry.slug}
  data-tier={tier}
  data-last-done={lastDone ? anchorMonth(lastDone).slice(0, 7) : undefined}
  class:list={["-mx-3 scroll-mt-4 px-3 py-4", saved ? SAVED_ROW_CLASS[saved.tone] : "first:pt-0 last:pb-0"]}
>
  <div class="flex flex-wrap items-start justify-between gap-x-3 gap-y-1">
    <h3 class="font-semibold text-foreground">{name}</h3>
    <TierBadge tier={tier} />
  </div>
  {saved && <SavedNote saved={saved} />}
  <p class="mt-1 text-sm text-muted-foreground">
    {t("dashboard.recommendations.howOften", { interval: describeInterval(interval, t) })}
  </p>
  {lastDone && <p class="mt-1 text-sm text-muted-foreground tabular-nums">{describeLastDone(lastDone, t, locale)}</p>}
  <p class="mt-2 flex flex-wrap gap-2">
    {entry.nfz_funded ? (
      <Badge variant="success">
        <BadgeCheck aria-hidden="true" />
        {t("dashboard.recommendations.badge.nfzFunded")}
      </Badge>
    ) : (
      <Badge variant="outline">
        <Wallet aria-hidden="true" />
        {t("dashboard.recommendations.badge.notNfzFunded")}
      </Badge>
    )}
    {entry.referral_required ? (
      <Badge variant="outline">
        <FileText aria-hidden="true" />
        {t("dashboard.recommendations.badge.referralRequired")}
      </Badge>
    ) : (
      <Badge variant="outline">
        <FileCheck aria-hidden="true" />
        {t("dashboard.recommendations.badge.noReferral")}
      </Badge>
    )}
  </p>

  <ScreeningActions
    slug={entry.slug}
    name={name}
    bounds={bounds}
    error={error}
    invalidField={invalidField}
    open={Boolean(error)}
  />

  <EntryDetails entry={entry}>
    <div>
      <dt class="font-medium text-foreground">{t("dashboard.recommendations.details.why")}</dt>
      <dd>
        {t.plural("dashboard.recommendations.why.age", age)}{" "}
        {t("dashboard.recommendations.why.rule", { rule: describeBranch(matchedBranch, t, locale) })}
      </dd>
    </div>
  </EntryDetails>
</li>
