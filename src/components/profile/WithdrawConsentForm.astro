---
import { CircleAlert } from "lucide-react";
import { Alert, AlertDescription } from "@/components/ui/alert";
import { Button } from "@/components/ui/button";
import { createT } from "@/i18n";

interface Props {
  /** The page rendering the form; `/api/consent/withdraw` sends errors back there. */
  from: "profile" | "onboarding";
  /** Translated `withdraw_*` error, if the last attempt failed. */
  error?: string | null;
}

const { from, error } = Astro.props;
const t = createT(Astro.locals.locale);
// On onboarding the form sits under the profile form in one card, so a divider separates them; on profile it has its
// own card.
---

<section aria-labelledby="withdraw-heading" class:list={[from === "onboarding" && "border-t border-border pt-6"]}>
  <form method="POST" action="/api/consent/withdraw" class="space-y-4">
    <input type="hidden" name="from" value={from} />
    <h2 id="withdraw-heading" class="font-heading text-lg font-semibold">
      {t("profile.withdraw.heading")}
    </h2>
    <p class="text-sm text-muted-foreground">{t("profile.withdraw.intro")}</p>
    <p class="text-sm text-muted-foreground">{t("profile.withdraw.deleted")}</p>
    <p class="text-sm text-muted-foreground">{t("profile.withdraw.kept")}</p>

    <label class="flex items-start gap-3 rounded-md border border-input bg-card p-3 text-sm">
      <input type="checkbox" name="confirm" value="yes" class="mt-0.5 size-4 shrink-0 accent-destructive" />
      <span>{t("profile.withdraw.checkbox")}</span>
    </label>

    {error && (
      <Alert variant="destructive">
        <CircleAlert aria-hidden="true" />
        <AlertDescription>{error}</AlertDescription>
      </Alert>
    )}

    <Button type="submit" variant="destructive" className="w-full">
      {t("profile.withdraw.submit")}
    </Button>
  </form>
</section>
