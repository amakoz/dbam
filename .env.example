SUPABASE_URL=###
SUPABASE_KEY=###
# Used only by the appointment reminder cron job (local: SECRET_KEY from `npx supabase status -o env`).
SUPABASE_SECRET_KEY=###
RESEND_API_KEY=###
REMINDER_TEST_TO=###
# Sender for every email; unset falls back to Resend's sandbox sender `Dbam <onboarding@resend.dev>`.
# EMAIL_FROM=Dbam <przypomnienia@notification.dbam.net.pl>
# Only the literal true or false is valid: anything else fails astro:env validation and breaks every request.
# Leave it unset in production (defaults to false).
EMAIL_DRY_RUN=true
