---
import "../styles/global.css";
import Banner from "@/components/Banner.astro";
import LanguageSwitcher from "@/components/LanguageSwitcher.astro";
import { createT } from "@/i18n";
import { missingConfigs } from "@/lib/config-status";

interface Props {
  title?: string;
}

const { locale } = Astro.locals;
const t = createT(locale);
const { title = t("meta.title") } = Astro.props;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
  </head>
  <body>
    {missingConfigs.map((cfg) => (
      <Banner variant="error">
        <strong>{t("config.warning")}</strong> {t(cfg.messageKey)}
        {cfg.docsUrl && (
          <>
            {" "}
            <a href={cfg.docsUrl} target="_blank" rel="noopener noreferrer">
              {t(cfg.docsLabelKey ?? "config.docs")}
            </a>
            .
          </>
        )}
      </Banner>
    ))}
    <slot />
    <LanguageSwitcher />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
