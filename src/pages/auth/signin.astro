---
import { CircleCheck } from "lucide-react";
import PublicHeader from "@/components/PublicHeader.astro";
import SignInForm from "@/components/auth/SignInForm";
import { Alert, AlertDescription } from "@/components/ui/alert";
import { Card, CardContent, CardFooter, CardHeader } from "@/components/ui/card";
import Layout from "@/layouts/Layout.astro";
import { createT } from "@/i18n";
import { authErrorMessageKey } from "@/lib/auth-errors";

// Auth forms are for signed-out visitors only; the dashboard sends unfinished onboarding on to /onboarding.
if (Astro.locals.user) {
  return Astro.redirect("/dashboard");
}

const { locale } = Astro.locals;
const t = createT(locale);
const errorCode = Astro.url.searchParams.get("error");
const serverError = errorCode ? t(authErrorMessageKey(errorCode)) : null;
const confirmed = Astro.url.searchParams.has("confirmed");

const focusRing = "focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none";
---

<Layout title={t("auth.signin.title")}>
  <a
    href="#main"
    class="sr-only rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none"
  >
    {t("nav.skipToContent")}
  </a>
  <div class="flex min-h-dvh flex-col">
    <PublicHeader />

    <main id="main" class="mx-auto w-full max-w-md space-y-4 px-4 flex flex-1 flex-col justify-center pt-8 pb-24">
      {confirmed && (
        <Alert role="status" className="border-success/40">
          <CircleCheck aria-hidden="true" />
          <AlertDescription className="text-foreground">{t("auth.signin.confirmed")}</AlertDescription>
        </Alert>
      )}
      <Card>
        <CardHeader>
          <h1 class="font-heading text-2xl font-semibold tracking-tight">{t("auth.signin.title")}</h1>
        </CardHeader>
        <CardContent>
          <SignInForm locale={locale} serverError={serverError} client:load />
        </CardContent>
        <CardFooter className="justify-center text-sm text-muted-foreground">
          <p>
            {t("auth.signin.noAccount")}{" "}
            <a
              href="/auth/signup"
              class:list={["rounded-sm font-medium text-primary underline-offset-4 hover:underline", focusRing]}
            >
              {t("auth.signin.signupLink")}
            </a>
          </p>
        </CardFooter>
      </Card>
    </main>
  </div>
</Layout>
