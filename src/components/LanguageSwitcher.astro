---
import { LOCALES, createT } from "@/i18n";

const { locale } = Astro.locals;
const t = createT(locale);
// Return to the same page (query included) after the cookie is set.
const next = Astro.url.pathname + Astro.url.search;
---

<form
  method="POST"
  action="/api/locale"
  aria-label={t("language.switcher")}
  class="fixed right-4 bottom-4 z-50 flex gap-1 rounded-full border border-white/20 bg-black/40 p-1 text-xs text-white backdrop-blur-md"
>
  <input type="hidden" name="next" value={next} />
  {LOCALES.map((code) => (
    <button
      type="submit"
      name="lang"
      value={code}
      lang={code}
      title={t(`language.${code}`)}
      aria-pressed={code === locale ? "true" : "false"}
      class:list={[
        "rounded-full px-2.5 py-1 font-medium transition-colors",
        code === locale ? "bg-white/20 text-white" : "text-white/60 hover:bg-white/10 hover:text-white",
      ]}
    >
      {code.toUpperCase()}
    </button>
  ))}
</form>
