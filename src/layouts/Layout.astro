---
import "../styles/global.css";
import { Font } from "astro:assets";
import LanguageSwitcher from "@/components/LanguageSwitcher.astro";
import { createT } from "@/i18n";

interface Props {
  title?: string;
  /** Pages with an app header render the switcher inline and hide the floating pill. */
  hideLanguageSwitcher?: boolean;
}

const { locale } = Astro.locals;
const t = createT(locale);
const { title = t("meta.title"), hideLanguageSwitcher = false } = Astro.props;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {/* Preload only the body font's basic Latin file; Fraunces (headings) is used on few pages and loads on demand. */}
    <Font cssVariable="--font-fraunces" />
    <Font cssVariable="--font-figtree" preload={[{ subset: "latin" }]} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    {!hideLanguageSwitcher && <LanguageSwitcher />}
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
