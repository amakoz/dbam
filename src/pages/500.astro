---
import { CloudOff } from "lucide-react";
import PublicHeader from "@/components/PublicHeader.astro";
import { buttonVariants } from "@/components/ui/button";
import { Card, CardContent, CardFooter, CardHeader } from "@/components/ui/card";
import Layout from "@/layouts/Layout.astro";
import { createT } from "@/i18n";

// Rendered by Astro for any uncaught error, e.g. Supabase being briefly unreachable while /dashboard loads the
// onboarding state. Deliberately shows no error details.
const t = createT(Astro.locals.locale);
const retry = Astro.url.pathname + Astro.url.search;
---

<Layout title={t("errorPage.title")}>
  <a
    href="#main"
    class="sr-only rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none"
  >
    {t("nav.skipToContent")}
  </a>
  <div class="flex min-h-dvh flex-col">
    <PublicHeader />

    <main id="main" class="mx-auto w-full max-w-md px-4 flex flex-1 flex-col justify-center pt-8 pb-24">
      <Card className="text-center" role="alert">
        <CardHeader className="justify-items-center">
          <CloudOff aria-hidden="true" className="size-10 text-muted-foreground" />
          <h1 class="font-heading text-2xl font-semibold tracking-tight">{t("errorPage.title")}</h1>
        </CardHeader>
        <CardContent>
          <p class="leading-relaxed text-muted-foreground">{t("errorPage.message")}</p>
        </CardContent>
        <CardFooter className="flex-col gap-3 sm:flex-row sm:justify-center">
          <a href={retry} class:list={[buttonVariants(), "w-full sm:w-auto"]}>
            {t("errorPage.retry")}
          </a>
          <a href="/" class:list={[buttonVariants({ variant: "outline" }), "w-full sm:w-auto"]}>
            {t("errorPage.home")}
          </a>
        </CardFooter>
      </Card>
    </main>
  </div>
</Layout>
