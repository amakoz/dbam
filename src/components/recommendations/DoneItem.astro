---
import { CircleAlert, CircleCheck } from "lucide-react";
import SavedNote from "@/components/recommendations/SavedNote.astro";
import { SAVED_ROW_CLASS, type SavedFeedback } from "@/components/recommendations/saved";
import { Alert, AlertDescription } from "@/components/ui/alert";
import { Badge } from "@/components/ui/badge";
import { Button } from "@/components/ui/button";
import { createT } from "@/i18n";
import { describeLastDone, formatMonth } from "@/lib/screenings/format";
import type { DoneView } from "@/lib/screenings/rules";

// A done exam that is not due again yet (or has no fixed interval): when it was done, when it is due again, and a
// button to undo the record. Once due again, the exam returns to its tier with a "last done" line instead.

interface Props {
  view: DoneView;
  /** Translated error of the last attempt on this exam. */
  error?: string | null;
  /** Translated confirmation when this exam was just marked done; highlights the row. */
  saved?: SavedFeedback | null;
}

const { view, error, saved } = Astro.props;
const { completion, entry, nextDue } = view;
const { locale } = Astro.locals;
const t = createT(locale);

const name = locale === "pl" ? entry.name_pl : entry.name_en;
---

<li
  id={`screening-${entry.slug}`}
  data-done
  data-slug={entry.slug}
  data-next-due={nextDue ? nextDue.slice(0, 7) : ""}
  data-last-done-on={completion.last_done_on ?? ""}
  data-saved={saved?.tone}
  class:list={["-mx-3 scroll-mt-4 px-3 py-4", saved ? SAVED_ROW_CLASS[saved.tone] : "first:pt-0 last:pb-0"]}
>
  <div class="flex flex-wrap items-start justify-between gap-x-3 gap-y-1">
    <h3 class="font-semibold text-foreground">{name}</h3>
    <Badge variant="success">
      <CircleCheck aria-hidden="true" />
      {t("dashboard.screenings.done.heading")}
    </Badge>
  </div>
  {saved && <SavedNote saved={saved} />}
  <p class="mt-1 text-sm text-muted-foreground tabular-nums">{describeLastDone(completion, t, locale)}</p>
  <p class="mt-1 text-sm text-muted-foreground tabular-nums">
    {nextDue
      ? t("dashboard.screenings.done.dueAgain", { month: formatMonth(nextDue, locale) })
      : t("dashboard.screenings.done.noInterval")}
  </p>

  {error && (
    <Alert variant="destructive" className="mt-3">
      <CircleAlert aria-hidden="true" />
      <AlertDescription>{error}</AlertDescription>
    </Alert>
  )}

  <form method="POST" action="/api/screenings" class="mt-3">
    <input type="hidden" name="intent" value="undone" />
    <input type="hidden" name="slug" value={entry.slug} />
    <Button type="submit" variant="outline" size="sm">
      {t("dashboard.screenings.done.undo")}
      <span class="sr-only">: {name}</span>
    </Button>
  </form>
</li>
