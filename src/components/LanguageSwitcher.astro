---
import { LOCALES, createT } from "@/i18n";

interface Props {
  /** Render in the flow (e.g. inside the app header) instead of as the floating bottom-right pill. */
  inline?: boolean;
}

const { inline = false } = Astro.props;
const { locale } = Astro.locals;
const t = createT(locale);
// Return to the same page after the cookie is set. One-shot feedback params are dropped, so a save confirmation or
// an error doesn't show again in the new language.
const params = new URLSearchParams(Astro.url.search);
for (const key of ["saved", "error"]) params.delete(key);
const query = params.toString();
const next = Astro.url.pathname + (query ? `?${query}` : "");
---

<form
  method="POST"
  action="/api/locale"
  aria-label={t("language.switcher")}
  class:list={[
    "flex gap-1 rounded-full border border-border bg-card p-1 text-xs text-foreground",
    !inline && "fixed right-4 bottom-4 z-50 shadow-sm",
  ]}
>
  <input type="hidden" name="next" value={next} />
  {LOCALES.map((code) => (
    <button
      type="submit"
      name="lang"
      value={code}
      lang={code}
      title={t(`language.${code}`)}
      aria-pressed={code === locale ? "true" : "false"}
      class:list={[
        "rounded-full px-2.5 py-1 font-medium transition-colors focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-card focus-visible:outline-none",
        code === locale
          ? "bg-primary text-primary-foreground"
          : "text-muted-foreground hover:bg-accent hover:text-accent-foreground",
      ]}
    >
      {code.toUpperCase()}
    </button>
  ))}
</form>
