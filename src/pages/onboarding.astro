---
import { CircleAlert, CircleCheck, LogOut } from "lucide-react";
import Layout from "@/layouts/Layout.astro";
import PublicHeader from "@/components/PublicHeader.astro";
import ProfileForm from "@/components/profile/ProfileForm";
import WithdrawConsentForm from "@/components/profile/WithdrawConsentForm.astro";
import { Alert, AlertDescription } from "@/components/ui/alert";
import { Button } from "@/components/ui/button";
import { Card, CardContent, CardHeader } from "@/components/ui/card";
import { createT } from "@/i18n";
import { HEALTH_DATA_CONSENT_VERSION, getOnboardingState } from "@/lib/consent";
import { errorMessageKey } from "@/lib/errors";
import { createClient } from "@/lib/supabase";

const { user, locale } = Astro.locals;
const t = createT(locale);

const supabase = createClient(Astro.request.headers, Astro.cookies);
if (!supabase || !user) {
  return Astro.redirect("/auth/signin");
}

// Consent comes first and stands alone; the profile form appears only once consent is on record.
const { state } = await getOnboardingState(supabase, user.id);
if (state === "complete") {
  return Astro.redirect("/dashboard");
}

// Consent and profile errors show next to their form; `withdraw_*` codes show in the withdraw section.
const errorCode = Astro.url.searchParams.get("error");
const errorText = errorCode ? t(errorMessageKey(errorCode)) : null;
const isWithdrawError = errorCode?.startsWith("withdraw_") ?? false;
const serverError = isWithdrawError ? null : errorText;
const withdrawError = isWithdrawError ? errorText : null;
const withdrawn = Astro.url.searchParams.has("withdrawn");

const consentSections = [
  ["onboarding.consent.dataHeading", "onboarding.consent.data"],
  ["onboarding.consent.purposeHeading", "onboarding.consent.purpose"],
  ["onboarding.consent.storageHeading", "onboarding.consent.storage"],
  ["onboarding.consent.withdrawHeading", "onboarding.consent.withdraw"],
] as const;
---

<Layout title={t("onboarding.title")}>
  <a
    href="#main"
    class="sr-only rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none"
  >
    {t("nav.skipToContent")}
  </a>
  <PublicHeader>
    <form method="POST" action="/api/auth/signout">
      <Button type="submit" variant="ghost" size="sm">
        <LogOut aria-hidden="true" />
        {t("nav.signout")}
      </Button>
    </form>
  </PublicHeader>

  <main id="main" class="mx-auto w-full max-w-xl space-y-4 px-4 pt-8 pb-24 sm:pt-16">
    {withdrawn && (
      <Alert role="status" className="border-success/40">
        <CircleCheck aria-hidden="true" />
        <AlertDescription className="text-foreground">{t("onboarding.withdrawn")}</AlertDescription>
      </Alert>
    )}

    {state === "needs_consent" ? (
      <Card>
        <CardHeader>
          <h1 class="font-heading text-2xl font-semibold tracking-tight">{t("onboarding.consent.heading")}</h1>
          <p class="text-sm text-muted-foreground">{t("onboarding.consent.intro")}</p>
        </CardHeader>
        <CardContent>
          <form method="POST" action="/api/consent/grant" class="space-y-4">
            <input type="hidden" name="version" value={HEALTH_DATA_CONSENT_VERSION} />
            <dl class="space-y-3 text-sm">
              {consentSections.map(([heading, body]) => (
                <div>
                  <dt class="font-semibold text-foreground">{t(heading)}</dt>
                  <dd class="text-muted-foreground">{t(body)}</dd>
                </div>
              ))}
            </dl>
            <p class="text-sm text-muted-foreground">{t("onboarding.consent.voluntary")}</p>

            <label class="flex items-start gap-3 rounded-md border border-input bg-card p-3 text-sm">
              <input
                type="checkbox"
                name="consent"
                value="yes"
                required
                class="mt-0.5 size-4 shrink-0 accent-primary"
              />
              <span>{t("onboarding.consent.checkbox")}</span>
            </label>

            {serverError && (
              <Alert variant="destructive">
                <CircleAlert aria-hidden="true" />
                <AlertDescription>{serverError}</AlertDescription>
              </Alert>
            )}

            <Button type="submit" className="w-full">
              {t("onboarding.consent.submit")}
            </Button>
          </form>
        </CardContent>
      </Card>
    ) : (
      <Card>
        <CardHeader>
          <h1 class="font-heading text-2xl font-semibold tracking-tight">{t("onboarding.profile.heading")}</h1>
          <p class="text-sm text-muted-foreground">{t("onboarding.profile.intro")}</p>
        </CardHeader>
        <CardContent className="space-y-8">
          {/* The island renders inside a display:contents <astro-island>, which ignores space-y margins; the div keeps the gap. */}
          <div>
            <ProfileForm locale={locale} mode="onboarding" serverError={serverError} client:load />
          </div>
          {/* Consent is active from here on, so withdrawing it must be possible before a profile exists (Art. 7(3)). */}
          <WithdrawConsentForm from="onboarding" error={withdrawError} />
        </CardContent>
      </Card>
    )}
  </main>
</Layout>
