---
import PublicHeader from "@/components/PublicHeader.astro";
import SignUpForm from "@/components/auth/SignUpForm";
import { Card, CardContent, CardFooter, CardHeader } from "@/components/ui/card";
import Layout from "@/layouts/Layout.astro";
import { createT } from "@/i18n";
import { authErrorMessageKey } from "@/lib/auth-errors";

// Auth forms are for signed-out visitors only; the dashboard sends unfinished onboarding on to /onboarding.
if (Astro.locals.user) {
  return Astro.redirect("/dashboard");
}

const { locale } = Astro.locals;
const t = createT(locale);
const errorCode = Astro.url.searchParams.get("error");
const serverError = errorCode ? t(authErrorMessageKey(errorCode)) : null;

const focusRing = "focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none";
---

<Layout title={t("auth.signup.title")}>
  <a
    href="#main"
    class="sr-only rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none"
  >
    {t("nav.skipToContent")}
  </a>
  <div class="flex min-h-dvh flex-col">
    <PublicHeader />

    <main id="main" class="mx-auto w-full max-w-md px-4 flex flex-1 flex-col justify-center pt-8 pb-24">
      <Card>
        <CardHeader>
          <h1 class="font-heading text-2xl font-semibold tracking-tight">{t("auth.signup.title")}</h1>
        </CardHeader>
        <CardContent>
          <SignUpForm locale={locale} serverError={serverError} client:load />
        </CardContent>
        <CardFooter className="justify-center text-sm text-muted-foreground">
          <p>
            {t("auth.signup.hasAccount")}{" "}
            <a
              href="/auth/signin"
              class:list={["rounded-sm font-medium text-primary underline-offset-4 hover:underline", focusRing]}
            >
              {t("auth.signup.signinLink")}
            </a>
          </p>
        </CardFooter>
      </Card>
    </main>
  </div>
</Layout>
