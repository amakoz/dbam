---
import Layout from "@/layouts/Layout.astro";
import ProfileForm from "@/components/profile/ProfileForm";
import { createT } from "@/i18n";
import { getOnboardingState } from "@/lib/consent";
import { errorMessageKey } from "@/lib/errors";
import { createClient } from "@/lib/supabase";

const { user, locale } = Astro.locals;
const t = createT(locale);

const supabase = createClient(Astro.request.headers, Astro.cookies);
if (!supabase || !user) {
  return Astro.redirect("/auth/signin");
}

// Consent comes first and stands alone; the profile form appears only once consent is on record.
const { state } = await getOnboardingState(supabase, user.id);
if (state === "complete") {
  return Astro.redirect("/dashboard");
}

const errorCode = Astro.url.searchParams.get("error");
const serverError = errorCode ? t(errorMessageKey(errorCode)) : null;
const withdrawn = Astro.url.searchParams.has("withdrawn");

const consentSections = [
  ["onboarding.consent.dataHeading", "onboarding.consent.data"],
  ["onboarding.consent.purposeHeading", "onboarding.consent.purpose"],
  ["onboarding.consent.storageHeading", "onboarding.consent.storage"],
  ["onboarding.consent.withdrawHeading", "onboarding.consent.withdraw"],
] as const;
---

<Layout title={t("onboarding.title")}>
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div class="w-full max-w-lg rounded-2xl border border-white/10 bg-white/10 p-6 text-white backdrop-blur-xl sm:p-8">
      {withdrawn && (
        <p
          class="mb-4 rounded-lg border border-green-500/30 bg-green-900/30 px-3 py-2 text-sm text-green-200"
          role="status"
        >
          {t("onboarding.withdrawn")}
        </p>
      )}

      {state === "needs_consent" ? (
        <form method="POST" action="/api/consent/grant" class="space-y-4">
          <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
            {t("onboarding.consent.heading")}
          </h1>
          <p class="text-sm text-blue-100/80">{t("onboarding.consent.intro")}</p>
          <dl class="space-y-3 text-sm">
            {consentSections.map(([heading, body]) => (
              <div>
                <dt class="font-semibold text-white">{t(heading)}</dt>
                <dd class="text-blue-100/80">{t(body)}</dd>
              </div>
            ))}
          </dl>
          <p class="text-sm text-blue-100/60">{t("onboarding.consent.voluntary")}</p>

          <label class="flex items-start gap-3 rounded-lg border border-white/20 bg-white/5 p-3 text-sm">
            <input
              type="checkbox"
              name="consent"
              value="yes"
              required
              class="mt-0.5 size-4 shrink-0 accent-purple-500"
            />
            <span>{t("onboarding.consent.checkbox")}</span>
          </label>

          {serverError && (
            <p class="rounded-lg border border-red-500/30 bg-red-900/30 px-3 py-2 text-sm text-red-300" role="alert">
              {serverError}
            </p>
          )}

          <button
            type="submit"
            class="w-full rounded-lg bg-purple-600 px-4 py-2 font-medium text-white transition-colors hover:bg-purple-500"
          >
            {t("onboarding.consent.submit")}
          </button>
        </form>
      ) : (
        <>
          <h1 class="mb-2 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
            {t("onboarding.profile.heading")}
          </h1>
          <p class="mb-6 text-sm text-blue-100/80">{t("onboarding.profile.intro")}</p>
          <ProfileForm locale={locale} mode="onboarding" serverError={serverError} client:load />
        </>
      )}

      <form method="POST" action="/api/auth/signout" class="mt-6 text-center">
        <button type="submit" class="text-sm text-purple-300 hover:underline">
          {t("nav.signout")}
        </button>
      </form>
    </div>
  </div>
</Layout>
