---
import { createT } from "@/i18n";
import type { CatalogEntry } from "@/lib/catalog/schema";

// The expandable details of a catalog entry, shared by the tier items and the "may apply" items. The default slot
// adds rows (a `<div>` with `<dt>`/`<dd>`) between "how to access" and the sources.

interface Props {
  entry: CatalogEntry;
}

const { entry } = Astro.props;
const { locale } = Astro.locals;
const t = createT(locale);

const name = locale === "pl" ? entry.name_pl : entry.name_en;
const summary = locale === "pl" ? entry.summary_pl : entry.summary_en;
const howToAccess = locale === "pl" ? entry.how_to_access_pl : entry.how_to_access_en;
// Several quotes often come from the same page; list each page once.
const sources = entry.sources.filter((source, i, all) => all.findIndex((s) => s.url === source.url) === i);
// `last_reviewed` is a plain date: format it in UTC so it never shifts by a day.
const reviewedOn = entry.last_reviewed
  ? new Intl.DateTimeFormat(locale, { dateStyle: "long", timeZone: "UTC" }).format(new Date(entry.last_reviewed))
  : null;
---

<details class="mt-2">
  <summary class="cursor-pointer text-sm text-purple-300 hover:underline">
    {t("dashboard.recommendations.details.toggle")}
    <span class="sr-only">: {name}</span>
  </summary>
  <dl class="mt-2 space-y-3 text-sm text-blue-100/80">
    <div>
      <dt class="font-semibold text-white">{t("dashboard.recommendations.details.about")}</dt>
      <dd>{summary}</dd>
    </div>
    <div>
      <dt class="font-semibold text-white">{t("dashboard.recommendations.details.howToAccess")}</dt>
      <dd>{howToAccess}</dd>
    </div>
    <slot />
    <div>
      <dt class="font-semibold text-white">{t("dashboard.recommendations.details.sources")}</dt>
      <dd>
        <ul class="space-y-1">
          {sources.map((source) => (
            <li>
              <a href={source.url} target="_blank" rel="noopener noreferrer" class="text-purple-300 hover:underline">
                {source.title}
                <span class="sr-only">{t("dashboard.recommendations.details.newTab")}</span>
              </a>
              <span class="text-blue-100/60"> — {source.publisher}</span>
            </li>
          ))}
        </ul>
      </dd>
    </div>
  </dl>
  {reviewedOn && (
    <p class="mt-3 text-xs text-blue-100/60">
      {t("dashboard.recommendations.details.reviewedOn", { date: reviewedOn })}
    </p>
  )}
</details>
