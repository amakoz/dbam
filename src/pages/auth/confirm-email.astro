---
import { MailCheck } from "lucide-react";
import PublicHeader from "@/components/PublicHeader.astro";
import { Card, CardContent, CardFooter, CardHeader } from "@/components/ui/card";
import Layout from "@/layouts/Layout.astro";
import { createT } from "@/i18n";

// With email confirmations off, sign-up starts a session and the user is already signed in: nothing to check.
if (Astro.locals.user) {
  return Astro.redirect("/dashboard");
}

const t = createT(Astro.locals.locale);

const focusRing = "focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none";
---

<Layout title={t("auth.confirm.pending.title")}>
  <a
    href="#main"
    class="sr-only rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none"
  >
    {t("nav.skipToContent")}
  </a>
  <div class="flex min-h-dvh flex-col">
    <PublicHeader />

    <main id="main" class="mx-auto w-full max-w-md px-4 flex flex-1 flex-col justify-center pt-8 pb-24">
      <Card className="text-center">
        <CardHeader className="justify-items-center">
          <MailCheck aria-hidden="true" className="size-10 text-primary" />
          <h1 class="font-heading text-2xl font-semibold tracking-tight">{t("auth.confirm.pending.title")}</h1>
        </CardHeader>
        <CardContent>
          <p class="leading-relaxed text-muted-foreground">{t("auth.confirm.pending.description")}</p>
        </CardContent>
        <CardFooter className="justify-center text-sm">
          <a
            href="/auth/signin"
            class:list={["rounded-sm font-medium text-primary underline-offset-4 hover:underline", focusRing]}
          >
            {t("auth.confirm.pending.link")}
          </a>
        </CardFooter>
      </Card>
    </main>
  </div>
</Layout>
