---
import { createT } from "@/i18n";
import { describeLastDone, formatMonth } from "@/lib/screenings/format";
import type { DoneView } from "@/lib/screenings/rules";

// A done exam that is not due again yet (or has no fixed interval): when it was done, when it is due again, and a
// button to undo the record. Once due again, the exam returns to its tier with a "last done" line instead.

interface Props {
  view: DoneView;
  /** Translated error of the last attempt on this exam. */
  error?: string | null;
}

const { view, error } = Astro.props;
const { completion, entry, nextDue } = view;
const { locale } = Astro.locals;
const t = createT(locale);

const name = locale === "pl" ? entry.name_pl : entry.name_en;
---

<li
  id={`screening-${entry.slug}`}
  data-done
  data-slug={entry.slug}
  data-next-due={nextDue ? nextDue.slice(0, 7) : ""}
  class="scroll-mt-4 rounded-lg border border-emerald-400/20 bg-emerald-500/5 p-3"
>
  <h4 class="font-medium text-white">{name}</h4>
  <p class="mt-1 text-sm text-blue-100/80">{describeLastDone(completion, t, locale)}</p>
  <p class="mt-1 text-sm text-blue-100/80">
    {nextDue
      ? t("dashboard.screenings.done.dueAgain", { month: formatMonth(nextDue, locale) })
      : t("dashboard.screenings.done.noInterval")}
  </p>

  {error && (
    <p class="mt-3 rounded-lg border border-red-500/30 bg-red-900/30 px-3 py-2 text-sm text-red-300" role="alert">
      {error}
    </p>
  )}

  <form method="POST" action="/api/screenings" class="mt-3">
    <input type="hidden" name="intent" value="undone" />
    <input type="hidden" name="slug" value={entry.slug} />
    <button
      type="submit"
      class="rounded-lg border border-white/20 bg-white/10 px-3 py-1.5 text-sm transition-colors hover:bg-white/20"
    >
      {t("dashboard.screenings.done.undo")}
      <span class="sr-only">: {name}</span>
    </button>
  </form>
</li>
