---
import { Bell, BellOff, CircleAlert, CircleCheck } from "lucide-react";
import { Alert, AlertDescription } from "@/components/ui/alert";
import { Badge } from "@/components/ui/badge";
import { Button } from "@/components/ui/button";
import { createT } from "@/i18n";

interface Props {
  /** Whether reminders are on now; the button flips this. */
  enabled: boolean;
  /** The state just saved (`/api/reminders` redirects with `?reminders=on|off`), for the status line. */
  saved?: "on" | "off" | null;
  /** Translated `reminders_*` error, if the last attempt failed. */
  error?: string | null;
}

const { enabled, saved, error } = Astro.props;
const t = createT(Astro.locals.locale);
const state = enabled ? "on" : "off";
// `scroll-mt-6` keeps the card's top edge in view when the dashboard hint links to `/profile#reminders`.
---

<section id="reminders" aria-labelledby="reminders-heading" class="scroll-mt-6">
  <form method="POST" action="/api/reminders" class="space-y-4" data-reminders={state}>
    <input type="hidden" name="enabled" value={enabled ? "off" : "on"} />
    <div class="flex flex-wrap items-center justify-between gap-2">
      <h2 id="reminders-heading" class="font-heading text-lg font-semibold">
        {t("profile.reminders.heading")}
      </h2>
      <Badge variant={enabled ? "secondary" : "outline"}>
        {enabled ? <Bell aria-hidden="true" /> : <BellOff aria-hidden="true" />}
        {t(enabled ? "profile.reminders.state.on" : "profile.reminders.state.off")}
      </Badge>
    </div>
    <p class="text-sm text-muted-foreground">{t("profile.reminders.disclosure")}</p>

    {saved && (
      <Alert role="status" className="border-success/40">
        <CircleCheck aria-hidden="true" />
        <AlertDescription className="text-foreground">
          {t(saved === "on" ? "profile.reminders.saved.on" : "profile.reminders.saved.off")}
        </AlertDescription>
      </Alert>
    )}

    {error && (
      <Alert variant="destructive">
        <CircleAlert aria-hidden="true" />
        <AlertDescription>{error}</AlertDescription>
      </Alert>
    )}

    <Button type="submit" variant={enabled ? "outline" : "default"} className="w-full">
      {t(enabled ? "profile.reminders.turnOff" : "profile.reminders.turnOn")}
    </Button>
  </form>
</section>
