---
import { CircleAlert } from "lucide-react";
import { Alert, AlertDescription } from "@/components/ui/alert";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { createT } from "@/i18n";
import type { ScreeningFormBounds } from "@/lib/screenings/format";

// The "plan or mark done" panel of an exam: two plain forms posting to `/api/screenings`, no JavaScript. On a tier
// item it adds a plan; on a planned item (`planned` set) it changes the date. Every outcome redirects back to the
// dashboard, to the item's anchor.
//
// `<input type="month">` is not used for the last exam: Firefox and Safari desktop don't support it. The native
// date input and selects follow the page's colour scheme (`color-scheme` on `:root`).

interface Props {
  slug: string;
  /** The exam's name, for the screen-reader label of the toggle. */
  name: string;
  bounds: ScreeningFormBounds;
  /** Translated error of the last attempt on this exam, shown above the panel. */
  error?: string | null;
  /** The form field the error is about (`date` = plan form, `done` = month/year); marks it invalid. */
  invalidField?: "date" | "done" | null;
  /** Renders the panel expanded (e.g. after an error). */
  open?: boolean;
  /** Set when the exam is already planned: prefills its date (null = no date yet; a passed date is not prefilled). */
  planned?: { appointmentDate: string | null };
}

const { slug, name, bounds, error, invalidField = null, open = false, planned } = Astro.props;
const t = createT(Astro.locals.locale);

const id = (field: string) => `screening-${slug}-${field}`;
// A field is marked invalid only while its form's error is shown, and then points to that error.
const dateInvalid = Boolean(error) && invalidField === "date";
// A passed appointment date is below `min`, so the browser would refuse to resubmit it unchanged; start empty instead.
const plannedDate = planned?.appointmentDate;
const dateValue = plannedDate && plannedDate >= bounds.minDate ? plannedDate : "";
const doneInvalid = Boolean(error) && invalidField === "done";

const doneFields = [
  {
    field: "done-month",
    name: "done_month",
    label: t("dashboard.screenings.done.monthLabel"),
    options: bounds.months.map(({ value, label }) => ({ value: String(value), label })),
  },
  {
    field: "done-year",
    name: "done_year",
    label: t("dashboard.screenings.done.yearLabel"),
    options: bounds.years.map((year) => ({ value: String(year), label: String(year) })),
  },
];
---

<div class="mt-3 space-y-3">
  {error && (
    <Alert variant="destructive" id={id("error")}>
      <CircleAlert aria-hidden="true" />
      <AlertDescription>{error}</AlertDescription>
    </Alert>
  )}
  <details open={open}>
    <summary class="w-fit cursor-pointer rounded-sm text-sm font-medium text-primary underline-offset-4 hover:underline focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none">
      {t(planned ? "dashboard.screenings.panel.togglePlanned" : "dashboard.screenings.panel.toggle")}
      <span class="sr-only">: {name}</span>
    </summary>
    <div class="mt-3 space-y-4 rounded-lg border border-border p-4">
      <form method="POST" action="/api/screenings">
        <input type="hidden" name="intent" value="plan" />
        <input type="hidden" name="slug" value={slug} />
        <fieldset class="space-y-2">
          <legend class="mb-2 text-sm font-semibold text-foreground">
            {t(planned ? "dashboard.screenings.plan.legendPlanned" : "dashboard.screenings.plan.legend")}
          </legend>
          <Label htmlFor={id("date")}>{t("dashboard.screenings.plan.dateLabel")}</Label>
          <Input
            id={id("date")}
            type="date"
            name="appointment_date"
            min={bounds.minDate}
            max={bounds.maxDate}
            defaultValue={dateValue}
            aria-describedby={dateInvalid ? `${id("date-hint")} ${id("error")}` : id("date-hint")}
            aria-invalid={dateInvalid ? true : undefined}
            className="w-full bg-background tabular-nums sm:w-auto"
          />
          <p id={id("date-hint")} class="text-xs text-muted-foreground">
            {t("dashboard.screenings.plan.dateHint")}
          </p>
          <Button type="submit">
            {t(planned ? "dashboard.screenings.plan.submitPlanned" : "dashboard.screenings.plan.submit")}
          </Button>
        </fieldset>
      </form>

      <form method="POST" action="/api/screenings" class="border-t border-border pt-4">
        <input type="hidden" name="intent" value="done" />
        <input type="hidden" name="slug" value={slug} />
        <fieldset class="space-y-2" aria-describedby={id("done-hint")}>
          <legend class="mb-2 text-sm font-semibold text-foreground">{t("dashboard.screenings.done.legend")}</legend>
          <div class="flex flex-wrap gap-3">
            {doneFields.map(({ field, name: fieldName, label, options }) => (
              <div class="space-y-1">
                <Label htmlFor={id(field)}>{label}</Label>
                <select
                  id={id(field)}
                  name={fieldName}
                  aria-invalid={doneInvalid ? "true" : undefined}
                  aria-describedby={doneInvalid ? id("error") : undefined}
                  class="h-9 rounded-md border border-input bg-background px-3 text-sm text-foreground shadow-xs outline-none focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring aria-invalid:border-destructive dark:bg-input/30"
                >
                  <option value="">—</option>
                  {options.map(({ value, label: optionLabel }) => (
                    <option value={value}>{optionLabel}</option>
                  ))}
                </select>
              </div>
            ))}
          </div>
          <p id={id("done-hint")} class="text-xs text-muted-foreground">
            {t("dashboard.screenings.done.hint")}
          </p>
          <Button type="submit">{t("dashboard.screenings.done.submit")}</Button>
        </fieldset>
      </form>
    </div>
  </details>
</div>
