---
import { createT } from "@/i18n";
import type { Recommendation } from "@/lib/catalog/recommend";
import { describeBranch, describeInterval } from "@/lib/catalog/wording";

interface Props {
  recommendation: Recommendation;
  /** The user's age by year of birth, as `recommend` computed it. */
  age: number;
}

const { recommendation, age } = Astro.props;
const { entry, tier, matchedBranch, interval } = recommendation;
const { locale } = Astro.locals;
const t = createT(locale);

const name = locale === "pl" ? entry.name_pl : entry.name_en;
const summary = locale === "pl" ? entry.summary_pl : entry.summary_en;
const howToAccess = locale === "pl" ? entry.how_to_access_pl : entry.how_to_access_en;
// Several quotes often come from the same page; list each page once.
const sources = entry.sources.filter((source, i, all) => all.findIndex((s) => s.url === source.url) === i);
// `last_reviewed` is a plain date: format it in UTC so it never shifts by a day.
const reviewedOn = entry.last_reviewed
  ? new Intl.DateTimeFormat(locale, { dateStyle: "long", timeZone: "UTC" }).format(new Date(entry.last_reviewed))
  : null;
const badge = "rounded-full border px-2 py-0.5 text-xs";
---

<li data-slug={entry.slug} data-tier={tier} class="rounded-lg border border-white/10 bg-white/5 p-3">
  <h4 class="font-medium text-white">{name}</h4>
  <p class="mt-1 text-sm text-blue-100/80">
    {t("dashboard.recommendations.howOften", { interval: describeInterval(interval, t) })}
  </p>
  <p class="mt-2 flex flex-wrap gap-2">
    <span
      class:list={[
        badge,
        entry.nfz_funded
          ? "border-emerald-400/30 bg-emerald-500/10 text-emerald-200"
          : "border-white/20 bg-white/10 text-blue-100/80",
      ]}
    >
      {t(
        entry.nfz_funded ? "dashboard.recommendations.badge.nfzFunded" : "dashboard.recommendations.badge.notNfzFunded",
      )}
    </span>
    <span
      class:list={[
        badge,
        entry.referral_required
          ? "border-amber-400/30 bg-amber-500/10 text-amber-200"
          : "border-white/20 bg-white/10 text-blue-100/80",
      ]}
    >
      {t(
        entry.referral_required
          ? "dashboard.recommendations.badge.referralRequired"
          : "dashboard.recommendations.badge.noReferral",
      )}
    </span>
  </p>

  <details class="mt-2">
    <summary class="cursor-pointer text-sm text-purple-300 hover:underline">
      {t("dashboard.recommendations.details.toggle")}
      <span class="sr-only">: {name}</span>
    </summary>
    <dl class="mt-2 space-y-3 text-sm text-blue-100/80">
      <div>
        <dt class="font-semibold text-white">{t("dashboard.recommendations.details.about")}</dt>
        <dd>{summary}</dd>
      </div>
      <div>
        <dt class="font-semibold text-white">{t("dashboard.recommendations.details.howToAccess")}</dt>
        <dd>{howToAccess}</dd>
      </div>
      <div>
        <dt class="font-semibold text-white">{t("dashboard.recommendations.details.why")}</dt>
        <dd>
          {t.plural("dashboard.recommendations.why.age", age)}{" "}
          {t("dashboard.recommendations.why.rule", { rule: describeBranch(matchedBranch, t, locale) })}
        </dd>
      </div>
      <div>
        <dt class="font-semibold text-white">{t("dashboard.recommendations.details.sources")}</dt>
        <dd>
          <ul class="space-y-1">
            {sources.map((source) => (
              <li>
                <a href={source.url} target="_blank" rel="noopener noreferrer" class="text-purple-300 hover:underline">
                  {source.title}
                  <span class="sr-only">{t("dashboard.recommendations.details.newTab")}</span>
                </a>
                <span class="text-blue-100/60"> — {source.publisher}</span>
              </li>
            ))}
          </ul>
        </dd>
      </div>
    </dl>
    {reviewedOn && (
      <p class="mt-3 text-xs text-blue-100/60">
        {t("dashboard.recommendations.details.reviewedOn", { date: reviewedOn })}
      </p>
    )}
  </details>
</li>
