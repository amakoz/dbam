---
import SavedNote from "@/components/recommendations/SavedNote.astro";
import { SAVED_ROW_CLASS, type SavedFeedback } from "@/components/recommendations/saved";
import ScreeningActions from "@/components/recommendations/ScreeningActions.astro";
import TierBadge from "@/components/recommendations/TierBadge.astro";
import { Button } from "@/components/ui/button";
import { createT } from "@/i18n";
import { formatDay, type ScreeningFormBounds } from "@/lib/screenings/format";
import type { PlanView } from "@/lib/screenings/rules";

// A planned exam in "Your plans": its appointment date (optional), a panel to change the date or mark it done, and
// a button to remove the plan. The app books nothing; the date is what the user arranged with the clinic.

interface Props {
  view: PlanView;
  bounds: ScreeningFormBounds;
  /** Translated error of the last attempt on this exam; opens its panel. */
  error?: string | null;
  /** The form field the error is about, marked invalid in the panel. */
  invalidField?: "date" | "done" | null;
  /** Translated confirmation when this exam was just saved (planned or its date changed); highlights the row. */
  saved?: SavedFeedback | null;
}

const { view, bounds, error, invalidField, saved } = Astro.props;
const { plan, entry, tier } = view;
const { locale } = Astro.locals;
const t = createT(locale);

const name = locale === "pl" ? entry.name_pl : entry.name_en;
const date = plan.appointment_date;
---

<li
  id={`screening-${entry.slug}`}
  data-plan
  data-slug={entry.slug}
  data-appointment={date ?? ""}
  class:list={["-mx-3 scroll-mt-4 px-3 py-4", saved ? SAVED_ROW_CLASS[saved.tone] : "first:pt-0 last:pb-0"]}
>
  <div class="flex flex-wrap items-start justify-between gap-x-3 gap-y-1">
    <h3 class="font-semibold text-foreground">{name}</h3>
    {tier !== null && <TierBadge tier={tier} />}
  </div>
  {saved && <SavedNote saved={saved} />}
  <p class="mt-1 text-sm text-muted-foreground tabular-nums">
    {date
      ? t("dashboard.screenings.plan.date", { date: formatDay(date, locale) })
      : t("dashboard.screenings.plan.noDate")}
  </p>

  <ScreeningActions
    slug={entry.slug}
    name={name}
    bounds={bounds}
    error={error}
    invalidField={invalidField}
    open={Boolean(error)}
    planned={{ appointmentDate: date }}
  />

  <form method="POST" action="/api/screenings" class="mt-3">
    <input type="hidden" name="intent" value="unplan" />
    <input type="hidden" name="slug" value={entry.slug} />
    <Button type="submit" variant="outline" size="sm">
      {t("dashboard.screenings.plan.remove")}
      <span class="sr-only">: {name}</span>
    </Button>
  </form>
</li>
